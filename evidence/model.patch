+	// the failed probe must not be in the snapshot
+	snap, err := os.ReadFile(snapPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assert.NotContains(t, string(snap), `"alias": "absent"`,
+		"failed reachability probe must not be recorded as a payload")
