+		t.Fatal(err)
+	}
+
+	o, e, err = cmd(t,
+		"-d", "merged="+mergeURL,
+		"--datasource-replay", snapPath,
+		"-i", tmpl).run()
+	assertSuccess(t, o, e, err, "one-two")
